                            </Grid.ColumnDefinitions>

                            <TextBox Text="{Binding FileName}"
                                     Style="{StaticResource TextBoxStyle}" 
                                     Grid.Column="0" 
                                     VerticalAlignment="Stretch" 
                                     HorizontalAlignment="Stretch" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
