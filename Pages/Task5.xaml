<Page x:Class="WPFTasks.Pages.Task5"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      xmlns:model="clr-namespace:WPFTasks.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task5">
    <Page.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>
    <Page.DataContext>
        <model:Task5ViewModel/>
    </Page.DataContext>
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Поля для ввода искомого слова и выбора файла -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Ввод искомого слова -->
            <TextBlock Text="Искомое слово:" Margin="10"
                       Grid.Row="1" Grid.Column="0"
                       Style="{StaticResource LabelTextStyle}" 
                       VerticalAlignment="Center"/>
            <TextBox x:Name="SearchWordTextBox" 
                     Text="{Binding SearchWord, UpdateSourceTrigger=PropertyChanged}"
                     Grid.Row="1" Grid.Column="1"
                     Style="{StaticResource TextBoxStyle}" 
                     Margin="10"/>
            <Button Content="Поиск" 
                    Grid.Row="1" Grid.Column="2" Margin="10"
                    Style="{StaticResource DarkButtonStyle}" 
                    Command="{Binding SearchCommand}" />

            <!-- Ввод пути к директории -->
            <TextBlock Text="Путь к директории:" Margin="10"
                       Grid.Row="0" Grid.Column="0"
                       Style="{StaticResource LabelTextStyle}" 
                       VerticalAlignment="Center" />
            <TextBox x:Name="DirectoryPathTextBox" 
                     Grid.Row="0" Grid.Column="1"
                     Text="{Binding DirectoryPath, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource TextBoxStyle}" 
                     Margin="10" />
                <Button Content="Обзор..." 
                    Grid.Row="0" Grid.Column="2" Margin="10"
                    Style="{StaticResource DarkButtonStyle}" 
                    Command="{Binding BrowseDirectoryCommand}" />
            </Grid>

            <Grid Grid.Row="1" Margin="10 0 10 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <CheckBox x:Name="ShowZeroEnters" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Margin="0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="16" FontWeight="Bold"
                              IsChecked="{Binding ShouldShowZeroFiles}" Content="Учитывать нулёвых "
                              Command="{Binding UpdateResultCommand, UpdateSourceTrigger=Default}"/>
                </Grid>
                <TextBlock x:Name="ResultTextBlock" 
                           Grid.Column="1"
                           Style="{StaticResource LabelTextStyle}" 
                           Margin="10" 
                           HorizontalAlignment="Center"
                           Text="Результат: " 
                           TextWrapping="Wrap"/>
                <TextBox x:Name="Result"
                         Text="{Binding Result}"
                         Style="{StaticResource TextBoxStyle}"
                         Grid.Row="1"
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
            <!-- Отображение прогресса поиска по каждому файлу -->
            <!--<ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10" Background="{DynamicResource PrimaryBackgroundColor}">
            <ItemsControl ItemsSource="{Binding FileSearchResults}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="5">
