                                     Margin="25 10 10 15" />
                            <TextBox Text="{Binding FileFolder}"
                                     Style="{StaticResource TextBoxStyle}" 
                                     Grid.Column="1" 
                                     VerticalAlignment="Stretch" 
                                     HorizontalAlignment="Stretch" 
                                     IsReadOnly="True" 
                                     TextWrapping="Wrap" 
                                     VerticalScrollBarVisibility="Auto" 
                                     Margin="25 10 10 15"/>
                            <TextBlock Text="{Binding Occurrences}"
