<Page x:Class="WPFTasks.Pages.ClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d"      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1">
    
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Настройки подключения -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="100"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0 0 10 10" Text="{Binding IpAddress}" ToolTip="IP Address" Style="{StaticResource TextBoxStyle}"/>
                <TextBox Grid.Column="1" Margin="0 0 10 10" Text="{Binding Port}" ToolTip="Port" Style="{StaticResource TextBoxStyle}"/>
                <TextBox Grid.Column="2" Margin="0 0 10 10" Text="{Binding Login}" ToolTip="Login" Style="{StaticResource TextBoxStyle}"/>
                <TextBox Grid.Column="3" Margin="0 0 10 10" Text="{Binding Password}" ToolTip="Password" Style="{StaticResource TextBoxStyle}"/>
                <Button Grid.Column="4" Margin="0 0 10 10" Content="Connect" Command="{Binding ConnectCommand, UpdateSourceTrigger=Default}" Style="{StaticResource DarkButtonStyle}"/>
                <TextBlock Grid.Column="5" Margin="0 0 0 10" Text="Client" Style="{DynamicResource LabelTextStyle}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- Чат -->
            <ListBox Grid.Row="1" ScrollViewer.VerticalScrollBarVisibility="Auto" ItemsSource="{Binding Messages}" Background="{DynamicResource PrimaryBackgroundColor}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Sender}" Style="{StaticResource LabelTextStyle}"/>
                            <TextBox Text="{Binding Content}" Style="{StaticResource TextBoxStyle}" TextWrapping="Wrap" IsReadOnly="True"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Отправка сообщения -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" Margin="0 10 10 0" Text="{Binding NewMessage, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource TextBoxStyle}" KeyDown="TextBox_KeyDown"/>
                <Button Grid.Column="1" Margin="0 10 0 0" Content="Send" Command="{Binding SendMessageCommand}" Style="{StaticResource DarkButtonStyle}"/>
            </Grid>
        </Grid>
    </Border>
</Page>
