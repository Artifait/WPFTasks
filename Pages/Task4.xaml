<Page x:Class="WPFTasks.Pages.Task4"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task4">

    <Page.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Искомое слово:" Margin="10"
                           Grid.Row="1" Grid.Column="0"
                           Style="{StaticResource LabelTextStyle}" 
                           VerticalAlignment="Center"/>
                <TextBox x:Name="SearchWordTextBox" 
                         Grid.Row="1" Grid.Column="1"
                         Style="{StaticResource TextBoxStyle}" 
                         HorizontalAlignment="Stretch"
                         Margin="10"/>
                <Button Content="Поиск" 
                        Grid.Row="1" Grid.Column="2" Margin="10"
                        Style="{StaticResource DarkButtonStyle}" 
                        Click="SearchWordInFileAsync_Click" />

                <TextBlock Text="Путь к файлу:"
                           Grid.Row="0" Grid.Column="0"
                           Margin="10"
                           Style="{StaticResource LabelTextStyle}" 
                           VerticalAlignment="Center" />
                <TextBox x:Name="FilePathTextBox" 
                         Style="{StaticResource TextBoxStyle}" 
                         Grid.Row="0" Grid.Column="1"
                         HorizontalAlignment="Stretch"
                         Margin="10" />
                <Button Content="Обзор..." 
                        Grid.Row="0" Grid.Column="2"
                        Style="{StaticResource DarkButtonStyle}" 
                        Click="BrowseFile_Click" 
                        Margin="10" />
            </Grid>
            <Grid Grid.Row="2" Margin="10 0 10 10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                
                <TextBlock x:Name="ResultTextBlock" 
                           Grid.Row="0"
                           Style="{StaticResource LabelTextStyle}" 
                           Margin="10" 
                           HorizontalAlignment="Center"
                           Text="Результат: " 
                           TextWrapping="Wrap"/>
                <TextBox x:Name="Result"
                         Style="{StaticResource TextBoxStyle}"
                         Grid.Row="1"
                         VerticalAlignment="Stretch" 
                         HorizontalAlignment="Stretch" 
                         IsReadOnly="True" 
                         TextWrapping="Wrap" 
                         VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </Grid>
    </Border>
</Page>