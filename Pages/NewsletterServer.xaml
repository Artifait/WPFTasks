<Page x:Class="WPFTasks.Pages.NewsletterServer"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="NewsletterServer">

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}" 
        BorderBrush="Gray" BorderThickness="2" Padding="10">
        <ScrollViewer VerticalScrollBarVisibility="Hidden">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Message Type -->
                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,5,10,5" 
                    Text="Message Type:" Style="{StaticResource LabelTextStyle}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,5" FontSize="20"
                    Style="{StaticResource TextBoxStyle}" x:Name="MessageTypeTextBox" />

                <!-- Payload -->
                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,5,10,5" 
                    Text="Payload:" Style="{StaticResource LabelTextStyle}" />
                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,5" 
                    Style="{StaticResource TextBoxStyle}" x:Name="PayloadTextBox"
                    AcceptsReturn="True" Height="100" TextWrapping="Wrap" />

                <!-- Headers Section -->
                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,5,10,5" 
                    Text="Headers:" Style="{StaticResource LabelTextStyle}" />
                <Grid Grid.Row="2" Grid.Column="1" Margin="0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.ColumnSpan="2" Margin="0,5" x:Name="HeadersPanel">
                        <!-- Dynamically Added Header Fields Will Be Inserted Here -->
                    </StackPanel>
                    <!-- Add Header Button -->
                    <Button Grid.Row="1" Grid.Column="1" Margin="5,0,0,0" 
                        Content="Add Header" Style="{StaticResource DarkButtonStyle}" 
                        HorizontalAlignment="Left" Click="AddHeaderButton_Click" />
                </Grid>

                <!-- Submit and Clear Buttons -->
                <Grid Grid.Row="4" Grid.ColumnSpan="2" Margin="0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0" FontSize="20" Margin="0 0 5 0" ToolTip="Введите IpEndPoint для удаления"
                        Style="{StaticResource TextBoxStyle}" x:Name="DeleteUserTextBox" />
                    <Button Grid.Column="1" Content="DeleteUser" Style="{StaticResource DarkButtonStyle}" VerticalAlignment="Bottom"
                        Margin="0,0,10,0" Click="DeleteUserButton_Click" />
                    <Button Grid.Column="2" Content="Clear Form" Style="{StaticResource DarkButtonStyle}" VerticalAlignment="Bottom"
                        Margin="0,0,10,0" Click="ClearFormButton_Click" />
                    <Button Grid.Column="3" Content="Send Message" Style="{StaticResource DarkButtonStyle}" VerticalAlignment="Bottom" 
                        Click="SendMessageButton_Click" />
                </Grid>
            </Grid>
        </ScrollViewer>
    </Border>
</Page>
