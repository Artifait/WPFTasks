<Page x:Class="WPFTasks.Pages.Task2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task2">

    <Page.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Margin="20 10 10 3"
                           Style="{StaticResource LabelTextStyle}">
                    Конные скачки
                </TextBlock>

                <Button x:Name="StartButton" Grid.Column="1" Margin="0 10 10 3"
                        Style="{StaticResource DarkButtonStyle}" Command="{Binding StartCommand}">
                    Старт
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="10" Background="{DynamicResource PrimaryBackgroundColor}">
                <ItemsControl ItemsSource="{Binding ProgressBars}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <ProgressBar Height="30" Grid.Column="0"
                                             Value="{Binding Progress}" 
                                             Maximum="100" 
                                             Background="{Binding BgColor}" 
                                             Foreground="{Binding FgColor}"
                                             Margin="0,0,10,0"/>

                                <TextBlock Text="{Binding HorseName}"
                                           Foreground="{DynamicResource PrimaryTextColor}"
                                           VerticalAlignment="Center"
                                           FontWeight="Bold"
                                           Grid.Column="1"
                                           Margin="10,0,0,0"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Button x:Name="ResetButton" Grid.Row="2" Margin="0 0 0 20" Width="100"
                    Style="{StaticResource DarkButtonStyle}" Command="{Binding ResetCommand}">
                Сброс
            </Button>
        </Grid>
    </Border>
</Page>
