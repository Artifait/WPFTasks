<Page x:Class="WPFTasks.Pages.Task2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      xmlns:vm="clr-namespace:WPFTasks.Core.ViewModels.HttpsPartOne;assembly=WPFTasks.Core"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task2">

    <Page.DataContext>
        <vm:Task2_Vm/>
    </Page.DataContext>
    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
        BorderBrush="Gray" BorderThickness="2" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock x:Name="Status" Text="Топ 100 книг из проекта Гуттенберг" 
                   FontSize="24" FontWeight="Bold" Style="{DynamicResource LabelTextStyle}"
                   HorizontalAlignment="Center" Margin="10"/>

            <!-- Список книг -->
            <ScrollViewer Grid.Row="1" Margin="10">
                <ItemsControl ItemsSource="{Binding Books}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border BorderThickness="1" BorderBrush="Gray" Margin="5" Padding="5">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- Обложка -->
                                    <Image Source="{Binding CoverUrl}" Width="100" Height="150" Grid.Column="0" Margin="5"/>

                                    <Grid  Grid.Column="1" Margin="10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Text="{Binding Title}" Style="{DynamicResource LabelTextStyle}" 
                                               FontSize="18" 
                                               FontWeight="Bold" 
                                               TextWrapping="Wrap" Margin="0 0 0 5"/>
                                        <Button Grid.Column="1" Content="Открыть текст" VerticalAlignment="Bottom" HorizontalAlignment="Right"
                                            Command="{Binding DataContext.LoadBookCommand, RelativeSource={RelativeSource AncestorType=Window}}" 
                                            CommandParameter="{Binding}" Click="Button_Click"
                                            Style="{StaticResource DarkButtonStyle}" Width="150"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Border>
</Page>
