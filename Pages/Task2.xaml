<Page x:Class="WPFTasks.Pages.Task2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:WPFTasks.Pages"
      xmlns:vm="clr-namespace:WPFTasks.ViewModels"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task2">
    <Page.Resources>
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Background" Value="{DynamicResource PrimaryBackgroundColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
        </Style>
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <vm:AddOffsetConverter x:Key="AddOffsetConverter"/>
        <vm:PointConverter x:Key="PointConverter" />
    </Page.Resources>
    <Border CornerRadius="5" Background="White"
            BorderBrush="Gray" BorderThickness="2">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Canvas Background="{DynamicResource PrimaryBackgroundColor}">
                <!-- Отображение дорог между остановками -->
                <ItemsControl ItemsSource="{Binding DisplayRoute.Links}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Line Stroke="Gray" StrokeThickness="2"
                                      X1="{Binding Start.X}"
                                      Y1="{Binding Start.Y}"
                                      X2="{Binding End.X}"
                                      Y2="{Binding End.Y}" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Отображение остановок -->
                <ItemsControl ItemsSource="{Binding DisplayRoute.Stops}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <!-- Пассажиры -->
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Disabled" 
                                              Width="80"
                                              Height="80"
                                              Background="{DynamicResource PrimaryBackgroundColor}"
                                              Canvas.Left="{Binding Pos.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=0}" 
                                              Canvas.Top="{Binding Pos.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=20}">        
                                    <ItemsControl ItemsSource="{Binding Passes, UpdateSourceTrigger=PropertyChanged}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="8" Rows="8"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Ellipse Width="10" Height="10" Fill="{Binding Filler}" Margin="0" ToolTip="{Binding BasePassenger.EndStop.Name}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <!-- Остановка -->
                                <Ellipse Width="20" Height="20" Fill="LightBlue"
                                         Canvas.Left="{Binding Pos.X}"
                                         Canvas.Top="{Binding Pos.Y}" ToolTip="{Binding Statistic, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="{Binding BaseStop.Name}"
                                           Style="{StaticResource LabelTextStyle}"
                                           Canvas.Left="{Binding Pos.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=15}"
                                           Canvas.Top="{Binding Pos.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=-25}" />

                                <!-- Прогресс-бар времени до следующего пассажира -->
                                <ProgressBar Width="50" Height="10"
                                             Maximum="{Binding BaseStop.NextPassengerInterval}" 
                                             Value="{Binding BaseStop.TimeUntilNextPassenger}" 
                                             Canvas.Left="{Binding Pos.X, Converter={StaticResource AddOffsetConverter}, ConverterParameter=30}" 
                                             Canvas.Top="{Binding Pos.Y, Converter={StaticResource AddOffsetConverter}, ConverterParameter=10}" />
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Отображение автобусов -->
                <ItemsControl ItemsSource="{Binding Buss}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Canvas>
                                <Rectangle Width="30" Height="15" Fill="{Binding Filler}"
                                           Canvas.Left="{Binding Pos.X}"
                                           Canvas.Top="{Binding Pos.Y}" ToolTip="{Binding Statistic}"/>
                            </Canvas>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Canvas>
        </ScrollViewer>
    </Border>
</Page>
