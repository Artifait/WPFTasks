<Page x:Class="WPFTasks.Pages.Task1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d"      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1">

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Обводка вокруг элементов для разделения -->
                <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Foreground="{DynamicResource PrimaryTextColor}" 
                               FontWeight="Bold" VerticalAlignment="Center" Text="Генераторы"
                               HorizontalAlignment="Center" FontSize="24"/>
                </Border>

                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Foreground="{DynamicResource PrimaryTextColor}" 
                               FontWeight="Bold" VerticalAlignment="Center" Text="Генератор Чисел"
                               HorizontalAlignment="Left" FontSize="24"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="CheckNumber" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Margin="0 0 40 0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold"/>
                </Border>

                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Foreground="{DynamicResource PrimaryTextColor}" 
                               FontWeight="Bold" VerticalAlignment="Center" Text="Генератор Букв"
                               HorizontalAlignment="Left" FontSize="24"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="CheckLetter" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Margin="0 0 40 0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold"/>
                </Border>

                <Border Grid.Row="3" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Foreground="{DynamicResource PrimaryTextColor}" 
                               FontWeight="Bold" VerticalAlignment="Center" Text="Генератор Символов"
                               HorizontalAlignment="Left" FontSize="24"/>
                </Border>
                <Border Grid.Row="3" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="CheckSymbol" VerticalAlignment="Center" HorizontalAlignment="Left"
                              Margin="0 0 40 0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold"/>
                </Border>
            </Grid>
            <Border Padding="5" Grid.Row="1" Margin="0 10 0 0">
                <TextBox x:Name="Output" AcceptsReturn="True" Background="{DynamicResource PrimaryBackgroundColor}" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold">
                </TextBox>
            </Border>
        </Grid>
    </Border>
</Page>
