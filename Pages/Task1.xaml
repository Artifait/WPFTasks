<Page x:Class="WPFTasks.Pages.Task1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d"      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1">

    <Page.Resources>
        <!-- TextBlock Style for Labels -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Button Style for Dark Themed Restart Buttons -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
        <Grid Margin="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Output Display -->
            <TextBox Grid.Row="0" 
                 Text="{Binding OutputText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                 IsReadOnly="False" 
                 FontSize="18"
                 VerticalAlignment="Center"
                 HorizontalAlignment="Center"
                 Width="400"
                 Height="50" />

            <!-- Keyboard Buttons -->
            <UniformGrid Grid.Row="1" Rows="4" Columns="3" Margin="10">
                <!-- Each button is bound to the OnKeyPress command with corresponding button number -->
                <Button Content="1" Command="{Binding KeyPressCommand}" CommandParameter="1" FontSize="16"/>
                <Button Content="2 ABC" Command="{Binding KeyPressCommand}" CommandParameter="2" FontSize="16"/>
                <Button Content="3 DEF" Command="{Binding KeyPressCommand}" CommandParameter="3" FontSize="16"/>

                <Button Content="4 GHI" Command="{Binding KeyPressCommand}" CommandParameter="4" FontSize="16"/>
                <Button Content="5 JKL" Command="{Binding KeyPressCommand}" CommandParameter="5" FontSize="16"/>
                <Button Content="6 MNO" Command="{Binding KeyPressCommand}" CommandParameter="6" FontSize="16"/>

                <Button Content="7 PQRS" Command="{Binding KeyPressCommand}" CommandParameter="7" FontSize="16"/>
                <Button Content="8 TUV" Command="{Binding KeyPressCommand}" CommandParameter="8" FontSize="16"/>
                <Button Content="9 WXYZ" Command="{Binding KeyPressCommand}" CommandParameter="9" FontSize="16"/>

                <Button Content="*" Command="{Binding OnSpecialCommand}" CommandParameter="*" FontSize="16"/>
                <Button Content="0" Command="{Binding KeyPressCommand}" CommandParameter="0" FontSize="16"/>
                <Button Content="#" Command="{Binding OnSpecialCommand}" CommandParameter="#" FontSize="16"/>
            </UniformGrid>

            <!-- Cursor Navigation -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button Content="Left" Command="{Binding MoveCursorLeftCommand}" FontSize="14" Margin="5"/>
                <Button Content="Right" Command="{Binding MoveCursorRightCommand}" FontSize="14" Margin="5"/>
            </StackPanel>
        </Grid>
    </Border>
</Page>
