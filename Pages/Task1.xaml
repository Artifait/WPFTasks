<Page x:Class="WPFTasks.Pages.Task1"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:WPFTasks.Pages"
      mc:Ignorable="d"      
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Task1">

    <Page.Resources>
        <!-- TextBlock Style for Labels -->
        <Style x:Key="LabelTextStyle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextColor}"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>

        <!-- Button Style for Dark Themed Restart Buttons -->
        <Style x:Key="DarkButtonStyle" TargetType="Button">
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="DarkSlateGray"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Page.Resources>

    <Border CornerRadius="5" Background="{DynamicResource SecundaryBackgroundColor}"
            BorderBrush="Gray" BorderThickness="2">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="auto"/>
                </Grid.ColumnDefinitions>

                <!-- Headers -->
                <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Style="{StaticResource LabelTextStyle}" 
                               VerticalAlignment="Center" Text="Генераторы"
                               HorizontalAlignment="Center" FontSize="24"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Style="{StaticResource LabelTextStyle}" 
                               VerticalAlignment="Center" Text="On/Off"
                               HorizontalAlignment="Center"/>
                </Border>
                <Border Grid.Row="0" Grid.Column="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Style="{StaticResource LabelTextStyle}" 
                               VerticalAlignment="Center" Text="Restart"
                               HorizontalAlignment="Center"/>
                </Border>

                <!-- Prime Number Generator Row -->
                <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Style="{StaticResource LabelTextStyle}" 
                               Text="Генератор Простых Чисел"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="CheckNumber" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Margin="0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold"
                              IsChecked="{Binding IsPrimeGeneratorEnabled}"/>
                </Border>
                <Border Grid.Row="1" Grid.Column="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <Button Style="{StaticResource DarkButtonStyle}"
                            Content="Сбросить" Command="{Binding ResetPrimeGeneratorCommand}"/>
                </Border>

                <!-- Fibonacci Generator Row -->
                <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <TextBlock Margin="20" Style="{StaticResource LabelTextStyle}" 
                               Text="Генератор Фибоначчи"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="1" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <CheckBox x:Name="CheckFibonacci" VerticalAlignment="Center" HorizontalAlignment="Center"
                              Margin="0" Foreground="{DynamicResource PrimaryTextColor}" FontSize="32" FontWeight="Bold"
                              IsChecked="{Binding IsFibonacciGeneratorEnabled}"/>
                </Border>
                <Border Grid.Row="2" Grid.Column="2" BorderBrush="LightGray" BorderThickness="0,0,0,1">
                    <Button Style="{StaticResource DarkButtonStyle}"
                            Content="Сбросить" Command="{Binding ResetFibonacciGeneratorCommand}"/>
                </Border>
            </Grid>

            <!-- Generator Outputs -->
            <Grid Grid.Row="1" Margin="0 10 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Prime Number Output -->
                <TextBlock Text="Результаты генерации простых чисел" 
                           FontWeight="Bold" FontSize="18" 
                           Foreground="{DynamicResource PrimaryTextColor}"
                           HorizontalAlignment="Center"/>
                <Border Grid.Column="0" Grid.Row="1" Padding="5" Margin="5">
                    <TextBox Text="{Binding PrimeNumbersOutput, Mode=OneWay}" 
                             AcceptsReturn="True" 
                             Background="{DynamicResource PrimaryBackgroundColor}" 
                             Foreground="{DynamicResource PrimaryTextColor}" 
                             FontSize="16" 
                             FontWeight="Bold" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Fibonacci Output -->
                <TextBlock Grid.Column="1" Text="Результаты генерации чисел Фибоначчи" 
                           FontWeight="Bold" FontSize="18" 
                           Foreground="{DynamicResource PrimaryTextColor}"
                           HorizontalAlignment="Center"/>
                <Border Grid.Column="1" Grid.Row="1" Padding="5" Margin="5">
                    <TextBox Text="{Binding FibonacciNumbersOutput, Mode=OneWay}" 
                             AcceptsReturn="True" 
                             Background="{DynamicResource PrimaryBackgroundColor}" 
                             Foreground="{DynamicResource PrimaryTextColor}" 
                             FontSize="16" 
                             FontWeight="Bold" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Page>
